{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "business-crisis-rooms-preview",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {"name": "CRISIS_ROOMS", "class_name": "CrisisRoom"}
    ]
  },
  "migrations": [
    {"tag": "room-v1", "new_sqlite_classes": ["CrisisRoom"]}
  ]
}
